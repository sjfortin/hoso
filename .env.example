# Copy to .env for local settings. Never commit .env.
HOSO_PORT=4312
HOSO_COMPUTER_NAME="Home Computer"
HOSO_STATE_DIR=.relay

# For phone access, set the exact private HTTPS origin from Tailscale Serve.
# Leave unset for localhost development (uses HOSO_PORT).
# HOSO_PUBLIC_ORIGIN=https://your-computer.your-network.ts.net
